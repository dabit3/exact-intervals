// Intervals: an interval-workout timer. Work and rest alternate for a number of rounds; the
// ring shows the current phase, and a finished workout is logged to a file by app.ts.
// The countdown is computed from a persisted date, never by counting
// ticks, so a test's `clock +240000` runs a whole Tabata deterministically in milliseconds.
use RowText from "exact:content"
sound "assets/cue.wav"

routes nav
  home "/"

shape Time
  epochAtZero: number
  utcOffset: number

shape Page
  frozen: bool

shape Session
  id: string
  name: string
  rounds: number
  work: number
  rest: number
  seconds: number
  at: number

shape History
  count: number
  seconds: number
  sessions: Session[]

shape Reply
  ok: bool
  error: string

shape Preset
  id: string
  name: string
  work: number
  rest: number
  rounds: number

fn pad2(n: number): string = n < 10 ? `0${n}` : `${n}`
fn mmss(ms: number): string = ceil(ms / 1000) >= 3600 ? `${floor(ceil(ms / 1000) / 3600)}:${pad2(floor(ceil(ms / 1000) / 60) % 60)}:${pad2(ceil(ms / 1000) % 60)}` : `${floor(ceil(ms / 1000) / 60)}:${pad2(ceil(ms / 1000) % 60)}`
fn valid(s: string, low: number, high: number): bool = match parseNumber(s) { case some(n) => n >= low and n <= high and n == floor(n), case none => false }
fn seconds(s: string, fallback: number, low: number, high: number): number = valid(s, low, high) ? match parseNumber(s) { case some(n) => n, case none => fallback } : fallback
fn plural(n: number, word: string): string = `${n} ${word}${n == 1 ? "" : "s"}`

component App
  resource time = exactTime() as shape Time
  resource page = exactPage() as shape Page
  resource history = loadHistory() as shape History else empty()
  mutation logged as shape Reply queue refreshes history then afterLog

  derive presets = [Preset(id="tabata", name="Tabata", work=20, rest=10, rounds=8), Preset(id="sprint", name="Sprints", work=30, rest=30, rounds=10), Preset(id="endurance", name="Endurance", work=45, rest=15, rounds=6)]
  state preset = "tabata" persist
  state name = "Tabata" persist
  state workText = "20" persist
  state restText = "10" persist
  state roundsText = "8" persist
  derive work = seconds(workText, 20, 1, 600)
  derive rest = seconds(restText, 10, 0, 600)
  derive rounds = seconds(roundsText, 8, 1, 99)

  // "idle", "running", "paused" or "done".
  state status = "idle" persist
  state startedAt = 0 persist
  state banked = 0 persist
  state sessionId = "" persist
  state completionPending = false persist
  state now = 0
  state segment = -1

  derive cycle = (work + rest) * 1000
  derive total = rounds * cycle - rest * 1000
  derive runningTime = banked + (status == "running" ? max(0, time.epochAtZero + now - startedAt) : 0)
  derive gettingReady = status != "idle" and status != "done" and runningTime < 5000
  derive elapsed = status == "done" ? total : min(total, max(0, runningTime - 5000))
  derive index = floor(elapsed / cycle)
  derive within = elapsed - index * cycle
  derive inWork = rest == 0 or within < work * 1000
  derive round = min(rounds, index + 1)
  derive activePhase = gettingReady ? "Get ready" : inWork ? "Work" : "Rest"
  derive phase = status == "done" ? "Done" : status == "idle" ? "Ready" : status == "paused" ? `Paused · ${activePhase}` : activePhase
  derive phaseLength = gettingReady ? 5000 : inWork ? work * 1000 : rest * 1000
  derive phaseLeft = status == "done" ? 0 : status == "idle" ? work * 1000 : gettingReady ? 5000 - runningTime : inWork ? work * 1000 - within : cycle - within
  derive fraction = status == "done" ? 1 : status == "idle" ? 0 : 1 - phaseLeft / phaseLength
  derive workValid = valid(workText, 1, 600)
  derive restValid = valid(restText, 0, 600)
  derive roundsValid = valid(roundsText, 1, 99)
  derive ready = workValid and restValid and roundsValid
  derive tint = status == "done" ? "AccentColor" : status == "idle" or gettingReady ? "-exact-tertiary-label" : inWork ? "-exact-system-green" : "-exact-system-orange"
  derive explanation = preset == "tabata" ? "20 seconds all-out, 10 seconds rest, 8 times. Pick one move — squats, burpees, high knees — and go hard during WORK." : preset == "sprint" ? "30 seconds fast, 30 seconds rest, 10 times. Run or cycle hard during WORK, then recover during REST." : preset == "endurance" ? "45 seconds steady effort, 15 seconds rest, 6 times. Pick a move and keep a pace you can sustain." : "Choose your work, rest and rounds. Move during WORK and recover during REST; the last round ends after work."
  derive editable = status == "idle" or status == "done"
  derive shown = time.epochAtZero + now

  task tick when status == "running" and current(time) and not page.frozen
    every(100, step)

  task restore when current(time)
    after(1, step)

  action afterLog
    if match logged { case some(reply) => reply.ok, case none => false }
      completionPending = false

  // A phase change is felt (a haptic on iPhone); the workout's end logs it once.
  action step
    let t = time.epochAtZero + performanceNow()
    let duration = banked + t - startedAt
    let e = max(0, duration - 5000)
    let n = floor(e / cycle)
    let seg = duration < 5000 ? -1 : n * 2 + (e - n * cycle < work * 1000 ? 0 : 1)
    now = performanceNow()
    if status == "running" and e >= total
      status = "done"
      completionPending = true
      haptic("success")
      playSound("assets/cue.wav")
      send logged = logSession(sessionId, name, rounds, work, rest, total / 1000, startedAt + total + 5000 - banked)
    else if status == "done" and completionPending
      send logged = logSession(sessionId, name, rounds, work, rest, total / 1000, startedAt + total + 5000 - banked)
    else if status == "running" and seg != segment
      segment = seg
      if rest > 0 or seg == 0
        haptic("impact-heavy")
        playSound("assets/cue.wav")

  action toggle
    let t = time.epochAtZero + performanceNow()
    now = performanceNow()
    if status == "running"
      banked = banked + t - startedAt
      status = "paused"
    else if status == "done"
      banked = 0
      segment = -1
      startedAt = t
      sessionId = `${t}`
      status = "running"
    else if ready
      if status == "idle"
        segment = -1
      startedAt = t
      if status == "idle"
        sessionId = `${t}`
      status = "running"

  action reset
    status = "idle"
    banked = 0
    segment = -1
    startedAt = 0
    sessionId = ""
    completionPending = false

  action choose(id: string, label: string, w: number, r: number, n: number)
    preset = id
    name = label
    workText = `${w}`
    restText = `${r}`
    roundsText = `${n}`
    status = "idle"
    banked = 0
    segment = -1

  action editWork(v: string)
    workText = v
    preset = "custom"
    name = "Custom"
    status = "idle"
    banked = 0
  action editRest(v: string)
    restText = v
    preset = "custom"
    name = "Custom"
    status = "idle"
    banked = 0
  action editRounds(v: string)
    roundsText = v
    preset = "custom"
    name = "Custom"
    status = "idle"
    banked = 0

  action follow(url: string)
    nav = go(nav, url)

  view
    main testId="root" navigationKey=`${top(nav).id}` navigate=follow width="100%" height="100%"
      for e in stack(nav) key=e.id
        if e.name == "home"
          column navigationKey=`${e.id}` navigationScroll="content" position="absolute" inset=0
            header display="flex" align-items="center" padding="8px 16px"
              text "Intervals" role="heading" aria-level=1 flex=1
            scroll id="content" flex=1 min-height=0
              row flex-wrap="wrap" align-items="flex-start" gap=20 padding=16 max-width="60rem" margin-left="auto" margin-right="auto"
                // The focal point: the ring, the phase's countdown, and the two controls.
                column flex="1 1 320px" min-width=0 align-items="center" gap=16 padding=24 border-radius=24
                  background-color="-exact-secondary-background" testId="timer"
                  text name font="-exact-headline" color="-exact-secondary-label" testId="workout-name"
                  column role="timer" aria-label=`${phase}, ${mmss(phaseLeft)}` position="relative" width="100%" max-width=280 aspect-ratio=1
                    svg viewBox="0 0 100 100" position="absolute" inset=0 width="100%" height="100%" aria-hidden=true color=tint
                      circle cx=50 cy=50 r=44 fill="none" stroke="-exact-tertiary-fill" stroke-width=7
                      if fraction > 0
                        circle cx=50 cy=50 r=44 fill="none" stroke="currentcolor" stroke-width=7 stroke-linecap="round"
                          pathLength=100 stroke-dasharray=`${min(1, fraction) * 100} 100` transform="rotate(-90 50 50)"
                    column position="absolute" inset=0 align-items="center" justify-content="center" gap=4
                      text mmss(phaseLeft) font-size="4rem" font-weight=600 font-variant-numeric="tabular-nums"
                        white-space="nowrap" -exact-fit="shrink" aria-hidden=true testId="left"
                      text phase.toUpperCase() font="-exact-headline" text-align="center" max-width="100%" color="-exact-secondary-label" aria-hidden=true testId="phase"
                  text (status == "idle" ? `${plural(rounds, "round")}` : `Round ${round} of ${rounds}`) font="-exact-title3"
                    font-variant-numeric="tabular-nums" testId="round"
                  text (not ready ? "Use whole seconds: work 1–600, rest 0–600; rounds 1–99" : status == "done" ? "Workout complete" : status == "idle" ? `${mmss(total)} total` : `${mmss(total - elapsed)} to go`)
                    color="-exact-secondary-label" font-variant-numeric="tabular-nums" testId="remaining"
                  if status == "idle"
                    text explanation font="-exact-footnote" color="-exact-secondary-label" text-align="center" width="100%" testId="explanation"
                  row justify-content="center" flex-wrap="wrap" gap=12 width="100%"
                    button press=reset disabled=(status == "idle") testId="reset" buttonStyle="gray"
                      -exact-corner-style="capsule" max-width="100%"
                      text "Reset" font-size="1rem"
                    button press=toggle disabled=(not ready) testId="start" buttonStyle="filled"
                      accent-color=(status == "running" ? "-exact-system-red" : "inherit")
                      -exact-corner-style="capsule" max-width="100%"
                      text (status == "running" ? "Pause" : status == "paused" ? "Resume" : status == "done" ? "Again" : "Start") font-size="1rem"

                column flex="1 1 320px" min-width=0 gap=20
                  // The workout: a preset, or its three numbers set by hand.
                  column gap=4 padding="16px 20px" border-radius=16 background-color="-exact-secondary-background" testId="workouts"
                    text "Workout" role="heading" aria-level=2 font="-exact-headline" margin-bottom=4
                    for p in presets key=p.id
                      button press=choose(p.id, p.name, p.work, p.rest, p.rounds) disabled=(not editable) testId=`preset-${p.id}`
                        display="flex" align-items="center" gap=12 padding="8px 0"
                        column flex=1 min-width=0 align-items="flex-start"
                          text p.name color="-exact-label"
                          text `${p.work}s work · ${p.rest}s rest · ${plural(p.rounds, "round")}` font="-exact-footnote" color="-exact-secondary-label"
                        if preset == p.id
                          image "symbol:checkmark" aria-label="Selected"
                    hr
                    row align-items="center" flex-wrap="wrap" gap=12 padding="4px 0"
                      text "Work (s)" flex="1 1 6rem"
                      input type="number" min=1 max=600 step=1 value=workText input=editWork disabled=(not editable) aria-label="Work seconds" testId="work" width="7rem" min-width=0 max-width="100%" text-align="end"
                        aria-invalid=(workValid ? "false" : "true") aria-describedby="work-help"
                    text (workValid ? "1–600 whole seconds" : "Enter work seconds as a whole number from 1 to 600.")
                      id="work-help" testId="work-help" font="-exact-footnote" color="-exact-secondary-label" aria-live="polite"
                    row align-items="center" flex-wrap="wrap" gap=12 padding="4px 0"
                      text "Rest (s)" flex="1 1 6rem"
                      input type="number" min=0 max=600 step=1 value=restText input=editRest disabled=(not editable) aria-label="Rest seconds" testId="rest" width="7rem" min-width=0 max-width="100%" text-align="end"
                        aria-invalid=(restValid ? "false" : "true") aria-describedby="rest-help"
                    text (restValid ? "0–600 whole seconds" : "Enter rest seconds as a whole number from 0 to 600.")
                      id="rest-help" testId="rest-help" font="-exact-footnote" color="-exact-secondary-label" aria-live="polite"
                    row align-items="center" flex-wrap="wrap" gap=12 padding="4px 0"
                      text "Rounds" flex="1 1 6rem"
                      input type="number" min=1 max=99 step=1 value=roundsText input=editRounds disabled=(not editable) aria-label="Rounds" testId="rounds" width="7rem" min-width=0 max-width="100%" text-align="end"
                        aria-invalid=(roundsValid ? "false" : "true") aria-describedby="rounds-help"
                    text (roundsValid ? "1–99 whole rounds" : "Enter rounds as a whole number from 1 to 99.")
                      id="rounds-help" testId="rounds-help" font="-exact-footnote" color="-exact-secondary-label" aria-live="polite"

                  // Finished workouts, newest first, kept in a file across launches.
                  column gap=4 padding="16px 20px" border-radius=16 background-color="-exact-secondary-background" testId="history"
                    text "History" role="heading" aria-level=2 font="-exact-headline"
                    if history.count == 0
                      text "No workouts yet. Finish one and it shows here." color="-exact-secondary-label" testId="history-empty"
                    else
                      text `${plural(history.count, "workout")} · ${mmss(history.seconds * 1000)} total` color="-exact-secondary-label"
                        font-variant-numeric="tabular-nums" testId="history-summary"
                      for s in history.sessions key=s.id
                        RowText(title=s.name, detail=`${s.rounds} × ${s.work}s / ${s.rest}s · ${formatDay(s.at, shown, time.utcOffset, "day-time")}`, value=some(mmss(s.seconds * 1000)))
