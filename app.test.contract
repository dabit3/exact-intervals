// Every test drives the app the way an agent does: tap, type, read the tree. `clock` is the
// agent-owned virtual clock, so a four-minute Tabata runs in milliseconds, identically on
// every host.

test "plain words preview applies only on request and runs the timer"
  size 1100x1000
  clock data
  expect disabled "apply"
  expect text "understood" == "Try \"8 rounds of 40 on 20 off\""
  type "describe" "8 rounds of 40 on 20 off"
  clock data
  expect text "understood" == "8 rounds · 40s work · 20s rest · 7:40 total"
  expect text "left" == "0:20"
  screenshot "/home/ubuntu/plain-words-shots/preview.png"
  tap "apply"
  expect state workText == "40"
  expect state restText == "20"
  expect state roundsText == "8"
  expect text "workout-name" == "Custom"
  expect text "remaining" == "7:40 total"
  screenshot "/home/ubuntu/plain-words-shots/applied.png"
  tap "start"
  clock +12000
  expect text "phase" == "WORK"
  expect text "left" == "0:33"
  expect text "round" == "Round 1 of 8"
  expect disabled "describe"
  expect disabled "apply"
  screenshot "/home/ubuntu/plain-words-shots/running.png"

test "plain words understand minutes and hard easy pairing"
  type "describe" "10 x 1 min hard, 30s easy"
  clock data
  expect text "understood" == "10 rounds · 60s work · 30s rest · 14:30 total"
  tap "apply"
  expect text "remaining" == "14:30 total"

test "plain words understand number words and work rest pairing"
  type "describe" "eight rounds 45 work 15 rest"
  clock data
  expect text "understood" == "8 rounds · 45s work · 15s rest · 7:45 total"
  type "describe" "8 rounds work 40, 20 rest"
  clock data
  expect text "understood" == "8 rounds · 40s work · 20s rest · 7:40 total"
  tap "apply"
  expect state workText == "40"
  expect state restText == "20"
  type "describe" "8 rounds 45 work rest 15"
  clock data
  expect text "understood" == "8 rounds · 45s work · 15s rest · 7:45 total"

test "plain words understand tabata and overrides"
  type "describe" "tabata"
  clock data
  expect text "understood" == "8 rounds · 20s work · 10s rest · 3:50 total"
  type "describe" "TABATA 10 rounds"
  clock data
  expect text "understood" == "10 rounds · 20s work · 10s rest · 4:50 total"

test "plain words understand colon durations and trailing rounds"
  type "describe" "1:30 on 30 off x 6"
  clock data
  expect text "understood" == "6 rounds · 90s work · 30s rest · 11:30 total"

test "plain words reject unsupported workouts and clear old previews"
  type "describe" "tabata"
  clock data
  expect enabled "apply"
  type "describe" "a pyramid of sprints"
  clock data
  expect text "understood" == "Didn't catch that — try \"10 x 1 min hard, 30s easy\""
  expect disabled "apply"
  expect text "workout-name" == "Tabata"
  type "describe" ""
  clock data
  expect text "understood" == "Try \"8 rounds of 40 on 20 off\""
  expect disabled "apply"

test "plain words report out of range values"
  type "describe" "8 rounds 601 work 20 rest"
  clock data
  expect text "understood" == "Work must be a whole number from 1 to 600 seconds."
  expect disabled "apply"
  type "describe" "100 x 40 on 20 off"
  clock data
  expect text "understood" == "Rounds must be a whole number from 1 to 99 rounds."
  expect disabled "apply"

test "plain words understand no rest and target duration"
  type "describe" "8 rounds 40 on 20 off for 4 minutes"
  clock data
  expect text "understood" == "Rounds and total duration conflict — adjust the rounds or the time target."
  expect disabled "apply"
  type "describe" "3 rounds 40 on 30 off for 3 minutes"
  clock data
  expect text "understood" == "3 rounds · 40s work · 30s rest · 3:00 total"
  expect enabled "apply"
  type "describe" "5 x 2 min"
  clock data
  expect text "understood" == "5 rounds · 120s work · 0s rest · 10:00 total"
  type "describe" "40 on 20 off for 8 minutes"
  clock data
  expect text "understood" == "8 rounds · 40s work · 20s rest · 7:40 total"

test "a fresh app is a Tabata, ready to start"
  clock data
  expect text "workout-name" == "Tabata"
  expect text "left" == "0:20"
  expect text "phase" == "READY"
  expect text "round" == "8 rounds"
  expect text "remaining" == "3:50 total"
  expect text "explanation" == "20 seconds all-out, 10 seconds rest, 8 times. Pick one move — squats, burpees, high knees — and go hard during WORK."

test "get ready counts down before work and resumes without restarting"
  clock data
  tap "start"
  expect text "phase" == "GET READY"
  expect text "left" == "0:05"
  expect text "round" == "Round 1 of 8"
  expect text "remaining" == "3:50 to go"
  expect sound missing "assets/cue.wav" at 0
  clock +4000
  expect text "left" == "0:01"
  tap "start"
  expect text "phase" == "PAUSED · GET READY"
  clock +60000
  expect text "left" == "0:01"
  tap "start"
  clock +1000
  expect text "phase" == "WORK"
  expect text "left" == "0:20"
  expect sound has "assets/cue.wav" at 65000

test "work counts down, then rest begins"
  clock data
  tap "start"
  expect text "start" == "Pause"
  clock +5000
  expect sound has "assets/cue.wav" at 5000
  clock +5000
  expect text "left" == "0:15"
  expect text "phase" == "WORK"
  expect text "round" == "Round 1 of 8"
  clock +16000
  expect text "phase" == "REST"
  expect text "left" == "0:09"
  expect sound has "assets/cue.wav" at 25000
  clock +10000
  expect text "phase" == "WORK"
  expect text "round" == "Round 2 of 8"
  expect sound has "assets/cue.wav" at 35000

test "pausing stops the clock and resuming picks up where it left off"
  clock data
  tap "start"
  clock +12000
  tap "start"
  expect text "phase" == "PAUSED · WORK"
  expect text "start" == "Resume"
  clock +60000
  expect text "left" == "0:13"
  tap "start"
  clock +3000
  expect text "left" == "0:10"
  expect text "phase" == "WORK"

test "a whole Tabata finishes and is logged to history"
  clock data
  tap "start"
  clock +235000
  clock data
  expect text "phase" == "DONE"
  expect text "remaining" == "Workout complete"
  expect text "start" == "Again"
  expect sound has "assets/cue.wav" at 235000
  expect text "history-summary" == "1 workout · 3:50 total"
  tap "start"
  expect text "phase" == "GET READY"
  expect text "left" == "0:05"
  clock +5000
  expect text "phase" == "WORK"
  expect text "left" == "0:20"
  reload
  clock data
  expect text "history-summary" == "1 workout · 3:50 total"

test "a custom workout is three numbers"
  clock data
  type "work" "40"
  type "rest" "20"
  type "rounds" "3"
  expect text "workout-name" == "Custom"
  expect text "left" == "0:40"
  expect text "remaining" == "2:40 total"
  tap "start"
  clock +46000
  expect text "phase" == "REST"
  expect text "round" == "Round 1 of 3"
  tap "start"
  expect text "phase" == "PAUSED · REST"
  clock +20000
  expect text "left" == "0:19"
  tap "start"
  clock +19000
  expect text "phase" == "WORK"

test "a blank field can't start a workout"
  clock data
  type "work" ""
  expect disabled "start"
  expect text "phase" == "READY"
  expect text "work-help" == "Enter work seconds as a whole number from 1 to 600."
  type "work" "15"
  expect enabled "start"
  expect text "work-help" == "1–600 whole seconds"

test "durations above their maximum cannot start"
  clock data
  type "work" "601"
  expect disabled "start"
  expect text "work-help" == "Enter work seconds as a whole number from 1 to 600."
  type "work" "600"
  expect enabled "start"
  type "rest" "601"
  expect disabled "start"
  expect text "rest-help" == "Enter rest seconds as a whole number from 0 to 600."
  type "rest" "600"
  expect enabled "start"

test "rounds must stay within their maximum"
  clock data
  type "rounds" "100"
  expect disabled "start"
  expect text "rounds-help" == "Enter rounds as a whole number from 1 to 99."
  type "rounds" "99"
  expect enabled "start"

test "settings require whole numbers and allow zero rest"
  clock data
  type "work" "1.5"
  expect disabled "start"
  type "work" "1"
  type "rest" "0"
  expect enabled "start"
  expect text "rest-help" == "0–600 whole seconds"
  type "rest" "1.5"
  expect disabled "start"
  type "rest" "1"
  type "rounds" "1.5"
  expect disabled "start"
  type "rounds" ""
  expect disabled "start"
  expect text "rounds-help" == "Enter rounds as a whole number from 1 to 99."
  type "rounds" "1"
  expect enabled "start"
  tap "start"
  clock +6000
  expect text "phase" == "DONE"

test "custom values must stay within each field's bounds"
  clock data
  type "work" "601"
  expect disabled "start"
  expect text "left" == "0:20"
  type "work" "0"
  expect disabled "start"
  type "work" "600"
  expect enabled "start"
  expect text "left" == "10:00"
  type "rest" "601"
  expect disabled "start"
  type "rest" "0"
  expect enabled "start"
  type "rest" "600"
  expect enabled "start"
  type "rounds" "100"
  expect disabled "start"
  expect text "round" == "8 rounds"
  type "rounds" "0"
  expect disabled "start"
  type "rounds" "99"
  expect enabled "start"
  expect text "round" == "99 rounds"
  type "work" "1"
  type "rest" "1"
  type "rounds" "1"
  expect enabled "start"
  tap "start"
  clock +6000
  expect text "phase" == "DONE"

test "reset returns to the start of the workout"
  clock data
  tap "preset-sprint"
  expect text "remaining" == "9:30 total"
  tap "start"
  clock +70000
  expect text "round" == "Round 2 of 10"
  tap "reset"
  expect text "phase" == "READY"
  expect text "left" == "0:30"
  reload
  expect text "phase" == "READY"
  expect text "left" == "0:30"
  expect tree has "history-empty"

test "reloading during work preserves the running workout"
  clock data
  tap "start"
  clock +12000
  reload
  expect text "phase" == "WORK"
  expect text "left" == "0:13"
  expect text "round" == "Round 1 of 8"
  clock +14000
  expect text "phase" == "REST"
  expect text "left" == "0:09"

test "reloading during rest preserves the round and continues counting"
  clock data
  tap "start"
  clock +30000
  reload
  expect text "phase" == "REST"
  expect text "left" == "0:05"
  expect text "round" == "Round 1 of 8"
  clock +6000
  expect text "phase" == "WORK"
  expect text "round" == "Round 2 of 8"
  expect text "left" == "0:19"

test "reloading a paused workout preserves its banked time"
  clock data
  tap "start"
  clock +12000
  tap "start"
  clock +60000
  reload
  expect text "phase" == "PAUSED · WORK"
  expect text "start" == "Resume"
  expect text "left" == "0:13"
  clock +60000
  expect text "left" == "0:13"
  tap "start"
  clock +3000
  expect text "left" == "0:10"

test "a workout finishing while suspended is logged once on relaunch"
  clock data
  tap "start"
  clock +7000
  prefer frozen true
  clock +240000
  expect state status == "running"
  reload
  clock +1
  clock data
  expect text "phase" == "DONE"
  expect text "left" == "0:00"
  expect text "round" == "Round 8 of 8"
  expect text "history-summary" == "1 workout · 3:50 total"
  reload
  clock +1000
  clock data
  expect text "phase" == "DONE"
  expect text "history-summary" == "1 workout · 3:50 total"

test "fractional settings are invalid until corrected"
  clock data
  type "work" "1.5"
  expect disabled "start"
  expect text "remaining" == "Use whole seconds: work 1–600, rest 0–600; rounds 1–99"
  type "work" "7"
  type "rest" "1.5"
  expect disabled "start"
  type "rest" "13"
  type "rounds" "1.5"
  expect disabled "start"
  type "rounds" "3"
  expect enabled "start"
  expect text "remaining" == "0:47 total"

test "settings enforce their upper and lower bounds"
  clock data
  type "work" "601"
  expect disabled "start"
  type "work" "600"
  type "rest" "601"
  expect disabled "start"
  type "rest" "600"
  type "rounds" "100"
  expect disabled "start"
  type "rounds" "99"
  expect enabled "start"
  expect text "remaining" == "32:50:00 total"
  type "work" "0"
  expect disabled "start"
  type "work" "1"
  type "rest" "-1"
  expect disabled "start"
  type "rest" "0"
  type "rounds" "0"
  expect disabled "start"
  type "rounds" "1"
  expect enabled "start"
  expect text "remaining" == "0:01 total"

test "no-rest rounds run back to back and log exactly their work"
  clock data
  type "work" "7"
  type "rest" "0"
  type "rounds" "3"
  expect text "remaining" == "0:21 total"
  tap "start"
  clock +5000
  expect text "phase" == "WORK"
  expect sound has "assets/cue.wav" at 5000
  clock +7000
  expect text "phase" == "WORK"
  expect text "round" == "Round 2 of 3"
  expect text "left" == "0:07"
  expect state inWork == true
  expect state phaseLength == 7000
  expect state fraction == 0
  expect sound missing "assets/cue.wav" at 12000
  clock +7000
  expect text "phase" == "WORK"
  expect text "round" == "Round 3 of 3"
  expect sound missing "assets/cue.wav" at 19000
  clock +7000
  clock data
  expect text "phase" == "DONE"
  expect text "history-summary" == "1 workout · 0:21 total"
  expect state history.sessions.0.seconds == 21
  expect state history.sessions.0.rest == 0
  reload
  clock data
  expect text "history-summary" == "1 workout · 0:21 total"

test "persisted input text determines the executed workout"
  clock data
  type "work" "7"
  type "rest" "0"
  type "rounds" "3"
  reload
  clock data
  expect state work == 7
  expect state rest == 0
  expect state rounds == 3
  expect text "remaining" == "0:21 total"
  tap "start"
  clock +26000
  clock data
  expect text "history-summary" == "1 workout · 0:21 total"
  expect state history.sessions.0.work == 7
  expect state history.sessions.0.rest == 0
  expect state history.sessions.0.rounds == 3

test "a no-rest workout restores running and paused rounds and logs once"
  clock data
  type "work" "7"
  type "rest" "0"
  type "rounds" "3"
  tap "start"
  clock +12000
  reload
  expect text "phase" == "WORK"
  expect text "round" == "Round 2 of 3"
  expect text "left" == "0:07"
  expect state rest == 0
  expect state phaseLength == 7000
  tap "start"
  reload
  expect text "phase" == "PAUSED · WORK"
  clock +60000
  expect text "left" == "0:07"
  tap "start"
  clock +14000
  clock data
  expect text "phase" == "DONE"
  expect text "history-summary" == "1 workout · 0:21 total"
  reload
  clock data
  expect text "history-summary" == "1 workout · 0:21 total"

test "hour-long workouts format totals and history as hours"
  clock data
  type "work" "600"
  type "rest" "0"
  type "rounds" "6"
  expect text "remaining" == "1:00:00 total"
  tap "start"
  clock +3605000
  clock data
  expect text "history-summary" == "1 workout · 1:00:00 total"
  expect state history.sessions.0.seconds == 3600
  reload
  clock data
  expect text "history-summary" == "1 workout · 1:00:00 total"
